{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "relationship-copilot",
  "compatibility_date": "2026-09-15",
  "compatibility_flags": ["nodejs_compat"],
  // vinext's fetch handler (worker/index.ts).
  "main": "./worker/index.ts",
  "assets": {
    "directory": "dist/client",
    "not_found_handling": "none",
    "binding": "ASSETS",
    // Prerendered pages live here; the Worker serves them so the raw cache
    // files are never public.
    "run_worker_first": ["/_vinext/static-cache/*"]
  },
  // Hourly reminder email (lib/workerCron.ts maps schedules to routes; a test
  // keeps the two in sync). The route is idempotent per person per local day.
  "triggers": {
    "crons": ["20 * * * *"]
  },
  // Non-secret runtime config. Secrets (Supabase service role, Stripe, xAI,
  // GA4 API secret, Resend, CRON_SECRET, NOTIFY_SECRET) are Worker secrets,
  // set with `npx wrangler secret put NAME --name relationship-copilot`;
  // deploys never touch them. NEXT_PUBLIC_* are build-time (.env.production).
  "vars": {
    "APP_ORIGIN": "https://relationshipcopilot.com",
    "GA4_MEASUREMENT_ID": "G-3HE7V5FTSR",
    "EMAIL_FROM": "Relationship Copilot <noreply@relationshipcopilot.com>"
  },
  "observability": {
    "enabled": true
  },
  // Custom domains (relationshipcopilot.com, www) are added at cutover, not
  // before; see docs/CLOUDFLARE_MIGRATION.md.
  "workers_dev": true,
  "preview_urls": true
}
