# Relationship Copilot (web) — environment template
# Copy to .env.local for Next.js. Never commit real secrets.

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-publishable-key
# Server-only (route handlers / server actions / edge functions). Bypasses RLS — keep secret.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Grok (xAI), OpenAI-compatible API ---
XAI_API_KEY=your-xai-api-key
XAI_BASE_URL=https://api.x.ai/v1
# Kept as an env var so the current Grok model can change without code edits.
# Optional; defaults to grok-latest (lib/grok.ts).
# XAI_MODEL=grok-latest
# Set to "true" ONLY once an enterprise no-training data agreement (DPA) is in
# place with the AI provider. Production deployments should not enable AI
# features without it; the app surfaces this provider in its user-facing
# disclosures (see the Blueprint/digest pages).
XAI_NO_TRAINING_DPA=false

# --- Stripe (freemium billing) ---
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_STRIPE_PRICE_PREMIUM=price_...
# Optional annual plan (roadmap item 8). Both must be set for the yearly
# button to render: the Stripe price id and the display string, e.g. "$59.99/yr".
NEXT_PUBLIC_STRIPE_PRICE_PREMIUM_ANNUAL=
NEXT_PUBLIC_PREMIUM_ANNUAL_DISPLAY=

# --- Notification email (optional) ---
# Resend HTTP API key. Unset = no notification emails are sent (the product
# still works; Account → Notifications simply has no effect yet). The sending
# domain is the same one Supabase auth mail already uses through Resend SMTP.
RESEND_API_KEY=
EMAIL_FROM="Relationship Copilot <noreply@relationshipcopilot.com>"
# Bearer token a scheduler sends to /api/cron/daily-reminder (Cloudflare
# Worker Cron Trigger; see docs/CLOUDFLARE_MIGRATION.md). Unset = 401.
CRON_SECRET=
# Required to sign one-click unsubscribe links when RESEND_API_KEY is set.
# Do not reuse the Supabase service-role key.
NOTIFY_SECRET=

# --- Web push (optional) ---
# VAPID key pair for browser notifications; no third-party account needed.
# Generate with `node scripts/vapid-keys.mjs` (--wrangler stores both as
# Worker secrets). Unset = the Account toggle is hidden and no pushes go out.
# Rotating the pair retires every existing browser subscription.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact the push services can reach (mailto: or https:).
VAPID_SUBJECT=mailto:privacy@relationshipcopilot.com

# --- App ---
# Local/preview origin for auth/billing redirects. Production should be the
# apex primary host (https://relationshipcopilot.com); www redirects there.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Social sign-in buttons to show on /login. List only providers that are
# actually enabled in the Supabase dashboard (comma-separated: google, apple,
# facebook). Unset shows all three; "none" hides them (email-only login).
NEXT_PUBLIC_AUTH_PROVIDERS=none
# Cloudflare Turnstile site key for the magic-link form (Supabase captcha
# protection). Unset defaults to the production site key (public by design);
# set "off" for local dev against a Supabase project with captcha disabled,
# or Cloudflare's always-passing test key 1x00000000000000000000AA.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=off

# --- Analytics (Google Tag Manager -> GA4) ---
# Container ID for the public marketing pages. Measurement is off entirely if
# this is unset, which is the right setting for local dev and previews.
# Production: GTM-NT4DZRHK → GA4 property G-3HE7V5FTSR.
# GA4 loads through this container and only on the public surface: the
# signed-in app (/connections, /account, /onboarding, /auth, /invite) is never
# measured, so connection and invite IDs never reach Google. Analytics cookies
# stay denied under Consent Mode v2 until the visitor accepts the banner;
# advertising signals are denied permanently.
NEXT_PUBLIC_GTM_ID=GTM-XXXXXXX
# Server-only Measurement Protocol (north-star first_mutual_reveal_completed).
# Same GA4 property as the GTM container; no-op when unset. Create the API
# secret under Admin → Data streams → Measurement Protocol API secrets.
# See docs/ga4-first-mutual-reveal.md.
GA4_MEASUREMENT_ID=G-3HE7V5FTSR
GA4_API_SECRET=
# Server-only HMAC salt for pseudonymous MP client_id. Required for any
# Measurement Protocol send (missing → fail closed, no event). Generate with
# `openssl rand -hex 32`, then on the Worker:
#   npx wrangler secret put GA4_CLIENT_ID_SALT --name relationship-copilot
GA4_CLIENT_ID_SALT=

# --- Error alerting (Cloudflare Worker only) ---
# Sentry DSN for the Worker (worker/index.ts). Unset = Sentry off. Every
# event is scrubbed first (lib/sentryScrub.ts): no relationship text, no
# personal data. Set with `npx wrangler secret put SENTRY_DSN`.
SENTRY_DSN=
